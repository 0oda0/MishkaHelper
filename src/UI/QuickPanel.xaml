<Window x:Class="MishkaHelper.Core.QuickPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" Width="420" SizeToContent="Height"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource MainFont}" FontSize="13">
    <Border Margin="16" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
            Background="#F2101019" Padding="16" Effect="{DynamicResource Glow}">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="&#xE713;" FontFamily="{StaticResource IconFont}"
                        Click="Open_Click" ToolTip="Открыть Mishka Helper"/>
                <TextBlock Text="MISHKA" FontWeight="Black" FontSize="16" Foreground="{DynamicResource AccentBrush}" Effect="{DynamicResource Glow}" VerticalAlignment="Center"/>
                <TextBlock x:Name="Stats" Margin="12,0" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" FontSize="12"/>
            </DockPanel>

            <WrapPanel x:Name="Tiles"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Button Style="{StaticResource GhostButton}" x:Name="MuteBtn" Content="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="16" Click="Mute_Click"/>
                <Slider Grid.Column="1" x:Name="Vol" Maximum="100" VerticalAlignment="Center" ValueChanged="Vol_Changed"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Vol, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Icon}" Text="&#xE706;" Margin="8,0,0,0" FontSize="16"/>
                <Slider Grid.Row="1" Grid.Column="1" x:Name="Bright" Maximum="100" VerticalAlignment="Center" ValueChanged="Bright_Changed"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=Bright, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <ComboBox x:Name="Output" Margin="0,10,0,0" DisplayMemberPath="Name" SelectionChanged="Output_Changed"/>

            <TextBlock Text="Режим" Style="{StaticResource Dim}" Margin="0,12,0,6"/>
            <WrapPanel x:Name="Modes"/>

            <TextBlock Text="Профили" Style="{StaticResource Dim}" Margin="0,6,0,6"/>
            <WrapPanel x:Name="ProfilesPanel"/>

            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Выход" Click="Quit_Click" Margin="0"/>
                <Button Style="{StaticResource AccentButton}" Click="Boost_Click" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BoostText" Text="Ускорить всё"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
