<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>MishkaHelper</AssemblyName>
    <RootNamespace>MishkaHelper</RootNamespace>
    <Version>0.8.1</Version>
    <Product>Mishka Helper</Product>
    <Company>Mishka</Company>
    <!-- WinForms is only used for NotifyIcon; avoid ambiguous usings -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Two editions from one codebase: full (default, with Jarvis) and Lite (dotnet publish -p:Flavor=Lite). -->
  <PropertyGroup Condition="'$(Flavor)' == 'Lite'">
    <DefineConstants>$(DefineConstants);LITE</DefineConstants>
    <Product>Mishka Helper Lite</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Flavor)' != 'Lite'">
    <!-- Jarvis: offline speech (Vosk / Whisper, Vulkan GPU). The LLM runs in llama.cpp's own server, downloaded on demand. -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <!-- Jarvis web sources: reads pages (e.g. a university schedule) with the user's own browser login -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup Condition="'$(Flavor)' == 'Lite'">
    <Compile Remove="Jarvis\**" />
    <Compile Remove="UI\JarvisUi.cs;UI\SelfTest.cs;Pages\JarvisPage.xaml.cs;Pages\ScenariosPage.xaml.cs" />
    <Page Remove="Pages\JarvisPage.xaml;Pages\ScenariosPage.xaml" />
  </ItemGroup>

  <!-- "Что можно сделать": the features landing page ships next to the exe. -->
  <ItemGroup>
    <Content Include="..\docs\features\**\*" LinkBase="docs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="..\docs\remote\index.html" LogicalName="remote.html" />
    <InternalsVisibleTo Include="MishkaHelper.Tests" />
  </ItemGroup>

</Project>
