<UserControl x:Class="MishkaHelper.Pages.WidgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Виджеты" Style="{StaticResource H1}"/>
        <TextBlock Text="Сами встают колонкой в правом верхнем углу и подтягиваются, когда какой-то скрыт. Перетащенный мышью остаётся, где поставил. Правый клик — «поверх окон», прозрачность, вернуть в колонку, скрыть." Style="{StaticResource Dim}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <Button Content="Выстроить все в колонку" Click="Arrange_Click" HorizontalAlignment="Left" Margin="0,0,0,18"/>
        <ContentControl x:Name="SearchHost" Margin="0,0,0,12" MaxWidth="420" HorizontalAlignment="Left"/>
        <WrapPanel x:Name="List"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Погода" Style="{StaticResource H2}"/>
                <WrapPanel>
                    <TextBox x:Name="City" Width="240" Margin="0,0,8,8"/>
                    <Button Content="Сохранить" Click="City_Click"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Dim}" Text="Погода — open-meteo.com, без ключей и регистрации."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
