<UserControl x:Class="MishkaHelper.Pages.WidgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Виджеты" Style="{StaticResource H1}"/>
        <TextBlock Text="Живут на рабочем столе. Перетаскивай мышью, правый клик — «поверх окон», прозрачность, скрыть." Style="{StaticResource Dim}" FontSize="13" Margin="0,0,0,18"/>
        <WrapPanel x:Name="List"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Погода" Style="{StaticResource H2}"/>
                <WrapPanel>
                    <TextBox x:Name="City" Width="240" Margin="0,0,8,8"/>
                    <Button Content="Сохранить" Click="City_Click"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Dim}" Text="Погода — open-meteo.com, без ключей и регистрации."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
