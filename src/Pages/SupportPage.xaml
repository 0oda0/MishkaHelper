<UserControl x:Class="MishkaHelper.Pages.SupportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Поддержка" Style="{StaticResource H1}"/>
        <TextBlock Text="Напиши, что сломалось или чего не хватает: ответ придёт сюда. Отправляется только то, что ты напишешь." Style="{StaticResource Dim}" FontSize="13" Margin="0,0,0,18" TextWrapping="Wrap"/>
        <Border Style="{StaticResource Card}">
            <StackPanel x:Name="Body"/>
        </Border>
    </StackPanel>
</UserControl>
