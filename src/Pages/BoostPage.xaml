<UserControl x:Class="MishkaHelper.Pages.BoostPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Ускорение" Style="{StaticResource H1}"/>
        <TextBlock Text="Очистка мусора, автозагрузка, большие файлы и лишние программы" Style="{StaticResource Dim}" FontSize="13" Margin="0,0,0,14"/>
        <WrapPanel Margin="0,0,0,10">
            <RadioButton Style="{StaticResource Segment}" Content="Полная очистка" GroupName="tab" Tag="full" Checked="Tab_Checked" x:Name="TabFull"/>
            <RadioButton Style="{StaticResource Segment}" Content="Мусор" GroupName="tab" Tag="clean" Checked="Tab_Checked"/>
            <RadioButton Style="{StaticResource Segment}" Content="Автозагрузка" GroupName="tab" Tag="startup" Checked="Tab_Checked"/>
            <RadioButton Style="{StaticResource Segment}" Content="Большие файлы" GroupName="tab" Tag="large" Checked="Tab_Checked"/>
            <RadioButton Style="{StaticResource Segment}" Content="Дубликаты" GroupName="tab" Tag="dups" Checked="Tab_Checked"/>
            <RadioButton Style="{StaticResource Segment}" Content="Программы" GroupName="tab" Tag="apps" Checked="Tab_Checked"/>
        </WrapPanel>
        <ContentControl x:Name="Body"/>
    </StackPanel>
</UserControl>
