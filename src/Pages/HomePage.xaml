<UserControl x:Class="MishkaHelper.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MishkaHelper.Core">
    <StackPanel>
        <TextBlock x:Name="Hello" Style="{StaticResource H1}"/>
        <TextBlock x:Name="Sub" Style="{StaticResource Dim}" FontSize="13" Margin="0,0,0,18"/>

        <WrapPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Нагрузка" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal">
                        <c:Ring x:Name="RCpu" Width="104" Height="104" Caption="CPU" Margin="0,0,12,0"/>
                        <c:Ring x:Name="RGpu" Width="104" Height="104" Caption="GPU" Margin="0,0,12,0"/>
                        <c:Ring x:Name="RRam" Width="104" Height="104" Caption="RAM" Margin="0,0,12,0"/>
                        <c:Ring x:Name="RDisk" Width="104" Height="104" Caption="Диск"/>
                    </StackPanel>
                    <TextBlock x:Name="Temps" Style="{StaticResource Dim}" FontSize="13" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Width="300">
                <StackPanel>
                    <TextBlock Text="Ускорение" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Dim}" Text="Чистит временные файлы и кэши, сбрасывает DNS, освобождает память фоновых программ."/>
                    <Button x:Name="BoostBtn" Style="{StaticResource AccentButton}" Margin="0,14,0,6" Padding="18,12" Click="Boost_Click" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BoostText" Text="Ускорить всё" FontSize="15"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LastClean" Style="{StaticResource Dim}"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Быстрые действия" Style="{StaticResource H2}"/>
                <WrapPanel x:Name="Tiles"/>
                <TextBlock Text="Режим работы" Style="{StaticResource Dim}" Margin="0,8,0,6"/>
                <ContentControl x:Name="Modes"/>
            </StackPanel>
        </Border>

        <WrapPanel>
            <Border Style="{StaticResource Card}" MinWidth="320">
                <StackPanel>
                    <TextBlock Text="Профили" Style="{StaticResource H2}"/>
                    <ContentControl x:Name="ProfilesBox"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" MinWidth="320">
                <StackPanel>
                    <TextBlock Text="Защита" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="Sec" TextWrapping="Wrap"/>
                    <Button Content="Открыть «Защиту»" Margin="0,10,0,0" HorizontalAlignment="Left" Click="Sec_Click"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" MinWidth="320">
                <StackPanel>
                    <TextBlock Text="Заряд" Style="{StaticResource H2}"/>
                    <StackPanel x:Name="Batteries"/>
                </StackPanel>
            </Border>
        </WrapPanel>
    </StackPanel>
</UserControl>
